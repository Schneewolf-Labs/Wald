# --- Database -------------------------------------------------------------
# Matches docker-compose.yml defaults.
WALD_DATABASE_URL=postgresql+psycopg://wald:wald@localhost:5432/wald

# --- LLM / RAG ------------------------------------------------------------
# Leave these unset to run in dev mode (deterministic local embeddings,
# retrieval-only /ask with no LLM synthesis).
ANTHROPIC_API_KEY=
WALD_ANSWER_MODEL=claude-opus-5

# Any OpenAI-compatible /v1 chat endpoint takes precedence over Anthropic for /ask
# synthesis: a self-hosted llama.cpp server, or a Witchgrid routing URL such as
# http://cp:8765/v1/llama/<profile>/v1. Include the /v1.
#   WALD_LLM_BASE_URL=http://127.0.0.1:8080/v1
#   WALD_LLM_MODEL=              # omit for single-model servers that reject it
WALD_LLM_BASE_URL=
WALD_LLM_MODEL=
WALD_LLM_API_KEY=

# --- Embeddings -----------------------------------------------------------
# Any OpenAI-compatible /v1 endpoint takes precedence over Voyage. Point this at a
# self-hosted embedding server to get real semantic retrieval with no API key --
# the hash fallback is not semantic, so without one of these the semantic arm of
# hybrid search contributes noise. Include the /v1. Set EMBED_DIM to match the
# model, and recreate the embedding table if you change it (the column width is
# fixed at creation).
#   WALD_EMBED_BASE_URL=http://127.0.0.1:8082/v1
#   WALD_EMBED_MODEL=            # omit for single-model servers that reject it
#   WALD_EMBED_DIM=2048
WALD_EMBED_BASE_URL=
WALD_EMBED_API_KEY=

VOYAGE_API_KEY=
WALD_EMBED_MODEL=voyage-3.5
WALD_EMBED_DIM=1024

# --- Content --------------------------------------------------------------
# Directory of files that `wald-seed` loads. Gitignored: this is real tenant material.
WALD_CONTENT_DIR=content

# --- Server ---------------------------------------------------------------
WALD_HOST=0.0.0.0
WALD_PORT=8000
WALD_ENV=dev

# --- MCP server -----------------------------------------------------------
# stdio for an agent that spawns Wald as a child process; streamable-http for remote
# agents. Loopback by default because the MCP surface is not yet authenticated.
WALD_MCP_TRANSPORT=stdio
WALD_MCP_HOST=127.0.0.1
WALD_MCP_PORT=8091
