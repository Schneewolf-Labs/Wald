# --- Database -------------------------------------------------------------
# Matches docker-compose.yml defaults.
WALD_DATABASE_URL=postgresql+psycopg://wald:wald@localhost:5432/wald

# --- LLM / RAG ------------------------------------------------------------
# Leave these unset to run in dev mode (deterministic local embeddings,
# retrieval-only /ask with no LLM synthesis).
ANTHROPIC_API_KEY=
WALD_ANSWER_MODEL=claude-opus-5

# --- Embeddings -----------------------------------------------------------
# Any OpenAI-compatible /v1 endpoint takes precedence over Voyage. Point this at a
# self-hosted embedding server to get real semantic retrieval with no API key --
# the hash fallback is not semantic, so without one of these the semantic arm of
# hybrid search contributes noise. Include the /v1. Set EMBED_DIM to match the
# model, and recreate the embedding table if you change it (the column width is
# fixed at creation).
#   WALD_EMBED_BASE_URL=http://127.0.0.1:8082/v1
#   WALD_EMBED_MODEL=            # omit for single-model servers that reject it
#   WALD_EMBED_DIM=2048
WALD_EMBED_BASE_URL=
WALD_EMBED_API_KEY=

VOYAGE_API_KEY=
WALD_EMBED_MODEL=voyage-3.5
WALD_EMBED_DIM=1024

# --- Content --------------------------------------------------------------
# Directory of files that `wald-seed` loads. Gitignored: this is real tenant material.
WALD_CONTENT_DIR=content

# --- Server ---------------------------------------------------------------
# Loopback by default, like the MCP server: with WALD_REQUIRE_AUTH off, the REST API
# takes any caller at their word. Bind wider once authentication is on.
WALD_HOST=127.0.0.1
WALD_PORT=8000
WALD_ENV=dev

# --- MCP server -----------------------------------------------------------
# stdio for an agent that spawns Wald as a child process; streamable-http for remote
# agents. Loopback by default because authentication is off by default.
WALD_MCP_TRANSPORT=stdio
WALD_MCP_HOST=127.0.0.1
WALD_MCP_PORT=8091

# --- Agent auth / authz ---------------------------------------------------
# REQUIRE_AUTH: bearer tokens (issue with `wald-token <agent>`); identity becomes proved
# rather than claimed. ENFORCE_AUTHZ: additionally enforce the `grants` list on each
# agent's registry entry (e.g. "wiki:read:*", "wiki:write:runbooks",
# "resource:read:merlina"); requires REQUIRE_AUTH, and an agent with no grants then has
# no knowledge access. Both are opt-in so an upgraded hub keeps serving its fleet, and
# both apply to the REST API and the MCP server alike.
WALD_REQUIRE_AUTH=false
WALD_ENFORCE_AUTHZ=false
# The web UI has no login, so it is closed while REQUIRE_AUTH is on. Set this when it sits
# behind authentication of your own (SSO proxy, VPN) and should stay reachable.
WALD_WEB_UI_OPEN=false

# --- Indexing -------------------------------------------------------------
# true: writes commit immediately and re-embedding runs on a worker thread (search may
# lag a write by a moment). false: chunks are written in the same transaction as the
# write -- read-your-writes search, at the cost of every write waiting on the embedding
# provider. The seed loader always indexes inline regardless.
WALD_BACKGROUND_INDEXING=true
